FormatVersion = "26.09.1"

[Setting]
CalendarSystem = "Gregorian"
NoteFormat = "Markdown"

[Subject]
Name = { First = "Gwangmu", Last = "Lee", Attrs = [ "Nickname:Lee" ] }
StartDate = { Year = 1991, Month = 3, Day = 29 }
Sex = "Male"

[[Event]]
ID = "borked"
Title = "Broken ID"

[[Event]]
ID = "e0"
Title = "Both-embedding event"
EmbedEvent = "/borked/path"
EmbedChart = "/borked/path"

[[Event]]
ID = "e1"
Title = "Swapped dates"
StartDate = { Year = 9999, Month = 1, Day = 2 }
EndDate = { Year = 0, Month = 1, Day = 2 }

[[Event]]
ID = "e1"
Title = "Infinite future date"
StartDate = { Year = 9999, Month = 1, Day = 2 }

[[Event]]
ID = "e2"
Title = "Infinite past date"
EndDate = { Year = 9999, Month = 1, Day = 2 }

[[Event]]
ID = "e3"
