FormatVersion = "26.09.1"

[[Event]]
ID = "e0"
Title = "Regular note"
Note = """
aaa

<!-- Edit: 2026-09-01 00:01:02 (UTC) -->
bbb
ccc
"""

[[Event]]
ID = "e1"
Title = "Note starting with a time tag"
Note = """
<!-- Edit: 2026-09-01 00:01:02 (UTC) -->
aaa

<!-- Edit: 2026-09-02 03:04:05 (UTC) -->
bbb
ccc
"""

[[Event]]
ID = "e2"
Title = "Note starting with an unknown time tag"
Note = """
<!-- Edit: -->
aaa
<!-- Edit: 2026-09-02 11:22:33 (UTC) -->
bbb
ccc
"""

[[Event]]
ID = "e3"
Title = "Note starting with incomplete time tags"
Note = """
aaa
<!-- Edit: 2026-09-02 11:22:33 (UTC) -->
bbb
ccc
<!-- Edit: 2026-09-02 11:22 -->
ddd
eee
<!-- Edit: 2026-09-02 (UTC) -->
fff
ggg
<!-- Edit: 2026-09-02 -->
hhh
iii
<!-- Edit: 2026-09 -->
jjj
kkk
<!-- Edit: 2026-09 fecked:up:time -->
lll
mmm
<!-- Edit: fecked up date (UTC) -->
nnn
ooo
"""

[[Event]]
ID = "e4"
Title = "Note starting with a time tag with a title"
Note = """
<!-- Title: whatever -->
<!-- Edit: 2026-09-01 00:01:02 (UTC) -->
aaa

<!-- Edit: 2026-09-01 00:01:02 (UTC) -->
bbb
ccc
"""

[[Event]]
ID = "e5"
Title = "Non-UTC timezone"
Note = """
<!-- Edit: 2026-09-01 00:01:02 (CET) -->
aaa

<!-- Edit: 2026-09-01 (Asia/Seoul) -->
aaa
<!-- Edit: 2026-09-01 00:01:02 (MyTZ) -->
bbb
ccc
"""
